{
  "name": "regal-live-coding",
  "version": "1.0.0",
  "packageManager": "yarn@1.22.22",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/ui": "~58.0.21",
    "@expo/vector-icons": "^15.0.2",
    "@shopify/flash-list": "2.3.2",
    "@tanstack/react-query": "^5.104.5",
    "expo": "~58.0.16",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.14",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.24",
    "expo-status-bar": "~58.0.3",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "json-server": "^1.0.0-beta.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "mock": "json-server movie-mock-api/db.json --port 3001 --host 0.0.0.0 --static movie-mock-api/public",
    "typecheck": "tsc --noEmit",
    "dev": "expo start --dev-client",
    "prebuild": "expo prebuild",
    "build:dev:ios": "eas build --profile development --platform ios",
    "build:dev:sim": "eas build --profile development-simulator --platform ios",
    "build:dev:android": "eas build --profile development --platform android",
    "lint": "expo lint"
  },
  "private": true
}
